<questestinterop xmlns="http://www.imsglobal.org/xsd/ims_qtiasiv1p2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.imsglobal.org/xsd/ims_qtiasiv1p2 http://www.imsglobal.org/xsd/ims_qtiasiv1p2p1.xsd"><assessment ident="g3sci-u08-quiz" title="Unit 8 Assessment · Human Impact &amp; Conservation"><qtimetadata><qtimetadatafield><fieldlabel>cc_maxattempts</fieldlabel><fieldentry>1</fieldentry></qtimetadatafield></qtimetadata><section ident="root_section"><item ident="g3sci-u08-q01" title="Question 1"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>multiple_choice_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1.0</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>g3sci-u08-q01-a,g3sci-u08-q01-b,g3sci-u08-q01-c,g3sci-u08-q01-d</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>assessment_question_identifierref</fieldlabel><fieldentry>g3sci-u08-q01-bank</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;Rain washes trash and oil off a parking lot and into a storm drain. Where does that water usually go next?&lt;/p&gt;</mattext></material><response_lid ident="response1" rcardinality="Single"><render_choice><response_label ident="g3sci-u08-q01-a"><material><mattext texttype="text/plain">Into creeks, rivers, lakes, and the ocean</mattext></material></response_label><response_label ident="g3sci-u08-q01-b"><material><mattext texttype="text/plain">Straight back up into the clouds</mattext></material></response_label><response_label ident="g3sci-u08-q01-c"><material><mattext texttype="text/plain">Into a cleaning plant every single time</mattext></material></response_label><response_label ident="g3sci-u08-q01-d"><material><mattext texttype="text/plain">Nowhere. It disappears into the ground right away.</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respident="response1">g3sci-u08-q01-a</varequal></conditionvar><setvar action="Set" varname="SCORE">100</setvar></respcondition></resprocessing></item><item ident="g3sci-u08-q02" title="Question 2"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>multiple_choice_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1.0</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>g3sci-u08-q02-a,g3sci-u08-q02-b,g3sci-u08-q02-c,g3sci-u08-q02-d</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>assessment_question_identifierref</fieldlabel><fieldentry>g3sci-u08-q02-bank</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;A meadow full of wildflowers is paved over to make a parking lot. What most likely happens to the bees and rabbits that lived there?&lt;/p&gt;</mattext></material><response_lid ident="response1" rcardinality="Single"><render_choice><response_label ident="g3sci-u08-q02-a"><material><mattext texttype="text/plain">They find more food on the warm pavement.</mattext></material></response_label><response_label ident="g3sci-u08-q02-b"><material><mattext texttype="text/plain">Nothing changes for them.</mattext></material></response_label><response_label ident="g3sci-u08-q02-c"><material><mattext texttype="text/plain">They lose food and shelter, so many must move or may not survive.</mattext></material></response_label><response_label ident="g3sci-u08-q02-d"><material><mattext texttype="text/plain">They turn into new kinds of animals.</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respident="response1">g3sci-u08-q02-c</varequal></conditionvar><setvar action="Set" varname="SCORE">100</setvar></respcondition></resprocessing></item><item ident="g3sci-u08-q03" title="Question 3"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>true_false_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1.0</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>g3sci-u08-q03-a,g3sci-u08-q03-b</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>assessment_question_identifierref</fieldlabel><fieldentry>g3sci-u08-q03-bank</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;Pollution can only harm water. It cannot get into the air or the land.&lt;/p&gt;</mattext></material><response_lid ident="response1" rcardinality="Single"><render_choice><response_label ident="g3sci-u08-q03-a"><material><mattext texttype="text/plain">True</mattext></material></response_label><response_label ident="g3sci-u08-q03-b"><material><mattext texttype="text/plain">False</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respident="response1">g3sci-u08-q03-b</varequal></conditionvar><setvar action="Set" varname="SCORE">100</setvar></respcondition></resprocessing></item><item ident="g3sci-u08-q04" title="Question 4"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>multiple_choice_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1.0</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>g3sci-u08-q04-a,g3sci-u08-q04-b,g3sci-u08-q04-c,g3sci-u08-q04-d</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>assessment_question_identifierref</fieldlabel><fieldentry>g3sci-u08-q04-bank</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;A thin, shiny film of oil is floating on a pond. Which cleanup tool would work best?&lt;/p&gt;</mattext></material><response_lid ident="response1" rcardinality="Single"><render_choice><response_label ident="g3sci-u08-q04-a"><material><mattext texttype="text/plain">A fishing net</mattext></material></response_label><response_label ident="g3sci-u08-q04-b"><material><mattext texttype="text/plain">An absorbent pad that soaks up oil</mattext></material></response_label><response_label ident="g3sci-u08-q04-c"><material><mattext texttype="text/plain">A magnet</mattext></material></response_label><response_label ident="g3sci-u08-q04-d"><material><mattext texttype="text/plain">A garden rake</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respident="response1">g3sci-u08-q04-b</varequal></conditionvar><setvar action="Set" varname="SCORE">100</setvar></respcondition></resprocessing></item><item ident="g3sci-u08-q05" title="Question 5"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>multiple_choice_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1.0</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>g3sci-u08-q05-a,g3sci-u08-q05-b,g3sci-u08-q05-c,g3sci-u08-q05-d</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>assessment_question_identifierref</fieldlabel><fieldentry>g3sci-u08-q05-bank</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;What does conservation mean?&lt;/p&gt;</mattext></material><response_lid ident="response1" rcardinality="Single"><render_choice><response_label ident="g3sci-u08-q05-a"><material><mattext texttype="text/plain">Using up natural resources as fast as possible</mattext></material></response_label><response_label ident="g3sci-u08-q05-b"><material><mattext texttype="text/plain">Studying the weather every day</mattext></material></response_label><response_label ident="g3sci-u08-q05-c"><material><mattext texttype="text/plain">Moving every wild animal into a zoo</mattext></material></response_label><response_label ident="g3sci-u08-q05-d"><material><mattext texttype="text/plain">Taking care of natural resources and habitats so they stay healthy and last</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respident="response1">g3sci-u08-q05-d</varequal></conditionvar><setvar action="Set" varname="SCORE">100</setvar></respcondition></resprocessing></item><item ident="g3sci-u08-q06" title="Question 6"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>multiple_choice_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1.0</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>g3sci-u08-q06-a,g3sci-u08-q06-b,g3sci-u08-q06-c,g3sci-u08-q06-d</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>assessment_question_identifierref</fieldlabel><fieldentry>g3sci-u08-q06-bank</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;Bald eagles almost disappeared because a bug poison called DDT made their eggshells thin. What helped the eagles come back?&lt;/p&gt;</mattext></material><response_lid ident="response1" rcardinality="Single"><render_choice><response_label ident="g3sci-u08-q06-a"><material><mattext texttype="text/plain">People banned DDT and protected eagle nests.</mattext></material></response_label><response_label ident="g3sci-u08-q06-b"><material><mattext texttype="text/plain">Eagles learned to lay eggs on the ground.</mattext></material></response_label><response_label ident="g3sci-u08-q06-c"><material><mattext texttype="text/plain">People fed the eagles bread.</mattext></material></response_label><response_label ident="g3sci-u08-q06-d"><material><mattext texttype="text/plain">The eagles moved to other countries.</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respident="response1">g3sci-u08-q06-a</varequal></conditionvar><setvar action="Set" varname="SCORE">100</setvar></respcondition></resprocessing></item><item ident="g3sci-u08-q07" title="Question 7"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>multiple_answers_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1.0</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>g3sci-u08-q07-a,g3sci-u08-q07-b,g3sci-u08-q07-c,g3sci-u08-q07-d</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>assessment_question_identifierref</fieldlabel><fieldentry>g3sci-u08-q07-bank</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;Which of these are ways to save water? Choose ALL that are correct.&lt;/p&gt;</mattext></material><response_lid ident="response1" rcardinality="Multiple"><render_choice><response_label ident="g3sci-u08-q07-a"><material><mattext texttype="text/plain">Fix a leaky faucet</mattext></material></response_label><response_label ident="g3sci-u08-q07-b"><material><mattext texttype="text/plain">Cover garden soil with mulch</mattext></material></response_label><response_label ident="g3sci-u08-q07-c"><material><mattext texttype="text/plain">Leave the sprinkler on while it rains</mattext></material></response_label><response_label ident="g3sci-u08-q07-d"><material><mattext texttype="text/plain">Catch rain in a rain barrel for the garden</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><and><varequal respident="response1">g3sci-u08-q07-a</varequal><varequal respident="response1">g3sci-u08-q07-b</varequal><not><varequal respident="response1">g3sci-u08-q07-c</varequal></not><varequal respident="response1">g3sci-u08-q07-d</varequal></and></conditionvar><setvar action="Set" varname="SCORE">100</setvar></respcondition></resprocessing></item><item ident="g3sci-u08-q08" title="Question 8"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>multiple_choice_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1.0</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>g3sci-u08-q08-a,g3sci-u08-q08-b,g3sci-u08-q08-c,g3sci-u08-q08-d</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>assessment_question_identifierref</fieldlabel><fieldentry>g3sci-u08-q08-bank</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;Why do scientists say that reducing waste is even better than recycling?&lt;/p&gt;</mattext></material><response_lid ident="response1" rcardinality="Single"><render_choice><response_label ident="g3sci-u08-q08-a"><material><mattext texttype="text/plain">Recycling makes more trash.</mattext></material></response_label><response_label ident="g3sci-u08-q08-b"><material><mattext texttype="text/plain">Reducing is only for grown-ups.</mattext></material></response_label><response_label ident="g3sci-u08-q08-c"><material><mattext texttype="text/plain">Reducing means less is used and thrown away in the first place.</mattext></material></response_label><response_label ident="g3sci-u08-q08-d"><material><mattext texttype="text/plain">Recycling never works.</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respident="response1">g3sci-u08-q08-c</varequal></conditionvar><setvar action="Set" varname="SCORE">100</setvar></respcondition></resprocessing></item><item ident="g3sci-u08-q09" title="Question 9"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>multiple_choice_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1.0</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>g3sci-u08-q09-a,g3sci-u08-q09-b,g3sci-u08-q09-c,g3sci-u08-q09-d</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>assessment_question_identifierref</fieldlabel><fieldentry>g3sci-u08-q09-bank</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;A wetland has many different kinds of living things. One kind of bird disappears from it. What is most likely to happen?&lt;/p&gt;</mattext></material><response_lid ident="response1" rcardinality="Single"><render_choice><response_label ident="g3sci-u08-q09-a"><material><mattext texttype="text/plain">The whole wetland falls apart right away.</mattext></material></response_label><response_label ident="g3sci-u08-q09-b"><material><mattext texttype="text/plain">Other living things fill in, and the wetland stays steadier than a place with only a few kinds.</mattext></material></response_label><response_label ident="g3sci-u08-q09-c"><material><mattext texttype="text/plain">Every other animal leaves too.</mattext></material></response_label><response_label ident="g3sci-u08-q09-d"><material><mattext texttype="text/plain">The wetland turns into a desert.</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respident="response1">g3sci-u08-q09-b</varequal></conditionvar><setvar action="Set" varname="SCORE">100</setvar></respcondition></resprocessing></item><item ident="g3sci-u08-q10" title="Question 10"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>multiple_choice_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1.0</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>g3sci-u08-q10-a,g3sci-u08-q10-b,g3sci-u08-q10-c,g3sci-u08-q10-d</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>assessment_question_identifierref</fieldlabel><fieldentry>g3sci-u08-q10-bank</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;A student writes a plan to protect a park's birds. Which is the best criterion for success, something you can check?&lt;/p&gt;</mattext></material><response_lid ident="response1" rcardinality="Single"><render_choice><response_label ident="g3sci-u08-q10-a"><material><mattext texttype="text/plain">"We want the park to be nice."</mattext></material></response_label><response_label ident="g3sci-u08-q10-b"><material><mattext texttype="text/plain">"Birds are important."</mattext></material></response_label><response_label ident="g3sci-u08-q10-c"><material><mattext texttype="text/plain">"Everyone should care about nature."</mattext></material></response_label><response_label ident="g3sci-u08-q10-d"><material><mattext texttype="text/plain">"The number of nesting birds goes up within two years."</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respident="response1">g3sci-u08-q10-d</varequal></conditionvar><setvar action="Set" varname="SCORE">100</setvar></respcondition></resprocessing></item></section></assessment></questestinterop>