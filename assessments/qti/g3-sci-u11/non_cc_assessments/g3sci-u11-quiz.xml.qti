<questestinterop xmlns="http://www.imsglobal.org/xsd/ims_qtiasiv1p2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.imsglobal.org/xsd/ims_qtiasiv1p2 http://www.imsglobal.org/xsd/ims_qtiasiv1p2p1.xsd"><assessment ident="g3sci-u11-quiz" title="Unit 11 Assessment · National Park Capstone"><qtimetadata><qtimetadatafield><fieldlabel>cc_maxattempts</fieldlabel><fieldentry>1</fieldentry></qtimetadatafield></qtimetadata><section ident="root_section"><item ident="g3sci-u11-q01" title="Question 1"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>multiple_choice_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1.0</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>g3sci-u11-q01-a,g3sci-u11-q01-b,g3sci-u11-q01-c,g3sci-u11-q01-d</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>assessment_question_identifierref</fieldlabel><fieldentry>g3sci-u11-q01-bank</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;A national park ecosystem has living parts and nonliving parts. Which of these is a nonliving part?&lt;/p&gt;</mattext></material><response_lid ident="response1" rcardinality="Single"><render_choice><response_label ident="g3sci-u11-q01-a"><material><mattext texttype="text/plain">A frog</mattext></material></response_label><response_label ident="g3sci-u11-q01-b"><material><mattext texttype="text/plain">Sunlight</mattext></material></response_label><response_label ident="g3sci-u11-q01-c"><material><mattext texttype="text/plain">A cypress tree</mattext></material></response_label><response_label ident="g3sci-u11-q01-d"><material><mattext texttype="text/plain">A heron</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respident="response1">g3sci-u11-q01-b</varequal></conditionvar><setvar action="Set" varname="SCORE">100</setvar></respcondition></resprocessing></item><item ident="g3sci-u11-q02" title="Question 2"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>true_false_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1.0</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>g3sci-u11-q02-a,g3sci-u11-q02-b</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>assessment_question_identifierref</fieldlabel><fieldentry>g3sci-u11-q02-bank</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;An alligator would survive well in a snowy mountain forest.&lt;/p&gt;</mattext></material><response_lid ident="response1" rcardinality="Single"><render_choice><response_label ident="g3sci-u11-q02-a"><material><mattext texttype="text/plain">True</mattext></material></response_label><response_label ident="g3sci-u11-q02-b"><material><mattext texttype="text/plain">False</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respident="response1">g3sci-u11-q02-b</varequal></conditionvar><setvar action="Set" varname="SCORE">100</setvar></respcondition></resprocessing></item><item ident="g3sci-u11-q03" title="Question 3"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>multiple_choice_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1.0</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>g3sci-u11-q03-a,g3sci-u11-q03-b,g3sci-u11-q03-c,g3sci-u11-q03-d</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>assessment_question_identifierref</fieldlabel><fieldentry>g3sci-u11-q03-bank</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;Wolves came back to Yellowstone in 1995. What happened next?&lt;/p&gt;</mattext></material><response_lid ident="response1" rcardinality="Single"><render_choice><response_label ident="g3sci-u11-q03-a"><material><mattext texttype="text/plain">The wolves ate all the plants.</mattext></material></response_label><response_label ident="g3sci-u11-q03-b"><material><mattext texttype="text/plain">Nothing else in the park changed.</mattext></material></response_label><response_label ident="g3sci-u11-q03-c"><material><mattext texttype="text/plain">The wolves changed how elk behaved, and that affected plants like willows.</mattext></material></response_label><response_label ident="g3sci-u11-q03-d"><material><mattext texttype="text/plain">The elk all moved to Florida.</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respident="response1">g3sci-u11-q03-c</varequal></conditionvar><setvar action="Set" varname="SCORE">100</setvar></respcondition></resprocessing></item><item ident="g3sci-u11-q04" title="Question 4"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>multiple_choice_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1.0</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>g3sci-u11-q04-a,g3sci-u11-q04-b,g3sci-u11-q04-c,g3sci-u11-q04-d</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>assessment_question_identifierref</fieldlabel><fieldentry>g3sci-u11-q04-bank</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;Maria's park presentation must show a food web and a conservation effort. What do scientists call requirements like these?&lt;/p&gt;</mattext></material><response_lid ident="response1" rcardinality="Single"><render_choice><response_label ident="g3sci-u11-q04-a"><material><mattext texttype="text/plain">Criteria</mattext></material></response_label><response_label ident="g3sci-u11-q04-b"><material><mattext texttype="text/plain">Constraints</mattext></material></response_label><response_label ident="g3sci-u11-q04-c"><material><mattext texttype="text/plain">Opinions</mattext></material></response_label><response_label ident="g3sci-u11-q04-d"><material><mattext texttype="text/plain">Habitats</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respident="response1">g3sci-u11-q04-a</varequal></conditionvar><setvar action="Set" varname="SCORE">100</setvar></respcondition></resprocessing></item><item ident="g3sci-u11-q05" title="Question 5"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>multiple_choice_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1.0</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>g3sci-u11-q05-a,g3sci-u11-q05-b,g3sci-u11-q05-c,g3sci-u11-q05-d</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>assessment_question_identifierref</fieldlabel><fieldentry>g3sci-u11-q05-bank</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;Which one is the strongest scientific evidence for a presentation about Yellowstone?&lt;/p&gt;</mattext></material><response_lid ident="response1" rcardinality="Single"><render_choice><response_label ident="g3sci-u11-q05-a"><material><mattext texttype="text/plain">Yellowstone is a cool park.</mattext></material></response_label><response_label ident="g3sci-u11-q05-b"><material><mattext texttype="text/plain">Wolves are my favorite animal.</mattext></material></response_label><response_label ident="g3sci-u11-q05-c"><material><mattext texttype="text/plain">I think wolves look scary.</mattext></material></response_label><response_label ident="g3sci-u11-q05-d"><material><mattext texttype="text/plain">Gray wolves hunt in packs, which lets them catch elk much bigger than one wolf could.</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respident="response1">g3sci-u11-q05-d</varequal></conditionvar><setvar action="Set" varname="SCORE">100</setvar></respcondition></resprocessing></item><item ident="g3sci-u11-q06" title="Question 6"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>multiple_answers_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1.0</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>g3sci-u11-q06-a,g3sci-u11-q06-b,g3sci-u11-q06-c,g3sci-u11-q06-d,g3sci-u11-q06-e</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>assessment_question_identifierref</fieldlabel><fieldentry>g3sci-u11-q06-bank</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;A long dry season hits the Everglades. Which of these living things there could be affected? Choose ALL that are correct.&lt;/p&gt;</mattext></material><response_lid ident="response1" rcardinality="Multiple"><render_choice><response_label ident="g3sci-u11-q06-a"><material><mattext texttype="text/plain">Water plants</mattext></material></response_label><response_label ident="g3sci-u11-q06-b"><material><mattext texttype="text/plain">Fish</mattext></material></response_label><response_label ident="g3sci-u11-q06-c"><material><mattext texttype="text/plain">Wading birds</mattext></material></response_label><response_label ident="g3sci-u11-q06-d"><material><mattext texttype="text/plain">Polar bears in the Arctic</mattext></material></response_label><response_label ident="g3sci-u11-q06-e"><material><mattext texttype="text/plain">Cactus in a desert</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><and><varequal respident="response1">g3sci-u11-q06-a</varequal><varequal respident="response1">g3sci-u11-q06-b</varequal><varequal respident="response1">g3sci-u11-q06-c</varequal><not><varequal respident="response1">g3sci-u11-q06-d</varequal></not><not><varequal respident="response1">g3sci-u11-q06-e</varequal></not></and></conditionvar><setvar action="Set" varname="SCORE">100</setvar></respcondition></resprocessing></item><item ident="g3sci-u11-q07" title="Question 7"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>multiple_choice_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1.0</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>g3sci-u11-q07-a,g3sci-u11-q07-b,g3sci-u11-q07-c,g3sci-u11-q07-d</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>assessment_question_identifierref</fieldlabel><fieldentry>g3sci-u11-q07-bank</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;What does interdependence mean?&lt;/p&gt;</mattext></material><response_lid ident="response1" rcardinality="Single"><render_choice><response_label ident="g3sci-u11-q07-a"><material><mattext texttype="text/plain">Living things never affect each other.</mattext></material></response_label><response_label ident="g3sci-u11-q07-b"><material><mattext texttype="text/plain">Living things depend on each other, so a change to one can affect the others.</mattext></material></response_label><response_label ident="g3sci-u11-q07-c"><material><mattext texttype="text/plain">Every animal lives all alone.</mattext></material></response_label><response_label ident="g3sci-u11-q07-d"><material><mattext texttype="text/plain">Plants do not need water.</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respident="response1">g3sci-u11-q07-b</varequal></conditionvar><setvar action="Set" varname="SCORE">100</setvar></respcondition></resprocessing></item><item ident="g3sci-u11-q08" title="Question 8"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>multiple_choice_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1.0</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>g3sci-u11-q08-a,g3sci-u11-q08-b,g3sci-u11-q08-c,g3sci-u11-q08-d</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>assessment_question_identifierref</fieldlabel><fieldentry>g3sci-u11-q08-bank</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;Which one is an example of people helping an ecosystem?&lt;/p&gt;</mattext></material><response_lid ident="response1" rcardinality="Single"><render_choice><response_label ident="g3sci-u11-q08-a"><material><mattext texttype="text/plain">Draining a marsh to build a parking lot</mattext></material></response_label><response_label ident="g3sci-u11-q08-b"><material><mattext texttype="text/plain">Cutting down mangroves along the shore</mattext></material></response_label><response_label ident="g3sci-u11-q08-c"><material><mattext texttype="text/plain">Raising a road onto bridges so water can flow into the Everglades</mattext></material></response_label><response_label ident="g3sci-u11-q08-d"><material><mattext texttype="text/plain">Dumping trash in a river</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respident="response1">g3sci-u11-q08-c</varequal></conditionvar><setvar action="Set" varname="SCORE">100</setvar></respcondition></resprocessing></item><item ident="g3sci-u11-q09" title="Question 9"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>multiple_choice_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1.0</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>g3sci-u11-q09-a,g3sci-u11-q09-b,g3sci-u11-q09-c,g3sci-u11-q09-d</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>assessment_question_identifierref</fieldlabel><fieldentry>g3sci-u11-q09-bank</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;Fires burned much of Yellowstone in 1988. What did scientists find growing in the burned forest the next spring?&lt;/p&gt;</mattext></material><response_lid ident="response1" rcardinality="Single"><render_choice><response_label ident="g3sci-u11-q09-a"><material><mattext texttype="text/plain">Tiny pine seedlings, from seeds that fell when the heat opened the pine cones</mattext></material></response_label><response_label ident="g3sci-u11-q09-b"><material><mattext texttype="text/plain">Nothing. The forest could never grow back.</mattext></material></response_label><response_label ident="g3sci-u11-q09-c"><material><mattext texttype="text/plain">Only snow and ice</mattext></material></response_label><response_label ident="g3sci-u11-q09-d"><material><mattext texttype="text/plain">Palm trees from Florida</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respident="response1">g3sci-u11-q09-a</varequal></conditionvar><setvar action="Set" varname="SCORE">100</setvar></respcondition></resprocessing></item><item ident="g3sci-u11-q10" title="Question 10"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>multiple_choice_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1.0</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>g3sci-u11-q10-a,g3sci-u11-q10-b,g3sci-u11-q10-c,g3sci-u11-q10-d</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>assessment_question_identifierref</fieldlabel><fieldentry>g3sci-u11-q10-bank</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;What is the difference between a guess and a conclusion?&lt;/p&gt;</mattext></material><response_lid ident="response1" rcardinality="Single"><render_choice><response_label ident="g3sci-u11-q10-a"><material><mattext texttype="text/plain">There is no difference.</mattext></material></response_label><response_label ident="g3sci-u11-q10-b"><material><mattext texttype="text/plain">A guess uses more evidence than a conclusion.</mattext></material></response_label><response_label ident="g3sci-u11-q10-c"><material><mattext texttype="text/plain">A conclusion is just your favorite answer.</mattext></material></response_label><response_label ident="g3sci-u11-q10-d"><material><mattext texttype="text/plain">A conclusion is based on evidence you collected, and a guess is not.</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respident="response1">g3sci-u11-q10-d</varequal></conditionvar><setvar action="Set" varname="SCORE">100</setvar></respcondition></resprocessing></item></section></assessment></questestinterop>