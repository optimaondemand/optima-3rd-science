<questestinterop xmlns="http://www.imsglobal.org/xsd/ims_qtiasiv1p2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.imsglobal.org/xsd/ims_qtiasiv1p2 http://www.imsglobal.org/xsd/ims_qtiasiv1p2p1.xsd"><assessment ident="g3sci-u06-quiz" title="Unit 6 Assessment · Fossils &amp; Earth History"><qtimetadata><qtimetadatafield><fieldlabel>cc_maxattempts</fieldlabel><fieldentry>1</fieldentry></qtimetadatafield></qtimetadata><section ident="root_section"><item ident="g3sci-u06-q01" title="Question 1"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>multiple_choice_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1.0</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>g3sci-u06-q01-a,g3sci-u06-q01-b,g3sci-u06-q01-c,g3sci-u06-q01-d</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>assessment_question_identifierref</fieldlabel><fieldentry>g3sci-u06-q01-bank</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;What is a fossil?&lt;/p&gt;</mattext></material><response_lid ident="response1" rcardinality="Single"><render_choice><response_label ident="g3sci-u06-q01-a"><material><mattext texttype="text/plain">What is left of a living thing from long ago, like a bone, shell, leaf, or footprint</mattext></material></response_label><response_label ident="g3sci-u06-q01-b"><material><mattext texttype="text/plain">A rock that wind carved into the shape of an animal</mattext></material></response_label><response_label ident="g3sci-u06-q01-c"><material><mattext texttype="text/plain">A plant or animal that is still alive today</mattext></material></response_label><response_label ident="g3sci-u06-q01-d"><material><mattext texttype="text/plain">A crystal that grows deep underground</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respident="response1">g3sci-u06-q01-a</varequal></conditionvar><setvar action="Set" varname="SCORE">100</setvar></respcondition></resprocessing></item><item ident="g3sci-u06-q02" title="Question 2"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>multiple_choice_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1.0</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>g3sci-u06-q02-a,g3sci-u06-q02-b,g3sci-u06-q02-c,g3sci-u06-q02-d</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>assessment_question_identifierref</fieldlabel><fieldentry>g3sci-u06-q02-bank</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;A fish dies and sinks to the bottom of a lake. What has to happen next for it to become a fossil?&lt;/p&gt;</mattext></material><response_lid ident="response1" rcardinality="Single"><render_choice><response_label ident="g3sci-u06-q02-a"><material><mattext texttype="text/plain">Wind and rain wear the rock away.</mattext></material></response_label><response_label ident="g3sci-u06-q02-b"><material><mattext texttype="text/plain">The fish floats back to the top.</mattext></material></response_label><response_label ident="g3sci-u06-q02-c"><material><mattext texttype="text/plain">Mud covers it, layer after layer.</mattext></material></response_label><response_label ident="g3sci-u06-q02-d"><material><mattext texttype="text/plain">A scientist digs it up right away.</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respident="response1">g3sci-u06-q02-c</varequal></conditionvar><setvar action="Set" varname="SCORE">100</setvar></respcondition></resprocessing></item><item ident="g3sci-u06-q03" title="Question 3"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>multiple_choice_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1.0</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>g3sci-u06-q03-a,g3sci-u06-q03-b,g3sci-u06-q03-c,g3sci-u06-q03-d</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>assessment_question_identifierref</fieldlabel><fieldentry>g3sci-u06-q03-bank</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;A scientist finds a fossil coral in a dry desert. What does this evidence most likely tell us?&lt;/p&gt;</mattext></material><response_lid ident="response1" rcardinality="Single"><render_choice><response_label ident="g3sci-u06-q03-a"><material><mattext texttype="text/plain">The place has always been a dry desert.</mattext></material></response_label><response_label ident="g3sci-u06-q03-b"><material><mattext texttype="text/plain">The wind blew the coral there from far away.</mattext></material></response_label><response_label ident="g3sci-u06-q03-c"><material><mattext texttype="text/plain">Coral lives in deserts today.</mattext></material></response_label><response_label ident="g3sci-u06-q03-d"><material><mattext texttype="text/plain">The desert was once covered by a warm, shallow ocean.</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respident="response1">g3sci-u06-q03-d</varequal></conditionvar><setvar action="Set" varname="SCORE">100</setvar></respcondition></resprocessing></item><item ident="g3sci-u06-q04" title="Question 4"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>multiple_choice_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1.0</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>g3sci-u06-q04-a,g3sci-u06-q04-b,g3sci-u06-q04-c,g3sci-u06-q04-d</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>assessment_question_identifierref</fieldlabel><fieldentry>g3sci-u06-q04-bank</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;A fossil tooth is wide and flat with bumps on top. What did the animal most likely eat?&lt;/p&gt;</mattext></material><response_lid ident="response1" rcardinality="Single"><render_choice><response_label ident="g3sci-u06-q04-a"><material><mattext texttype="text/plain">Rocks and sand</mattext></material></response_label><response_label ident="g3sci-u06-q04-b"><material><mattext texttype="text/plain">Plants</mattext></material></response_label><response_label ident="g3sci-u06-q04-c"><material><mattext texttype="text/plain">Other animals</mattext></material></response_label><response_label ident="g3sci-u06-q04-d"><material><mattext texttype="text/plain">Nothing at all</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respident="response1">g3sci-u06-q04-b</varequal></conditionvar><setvar action="Set" varname="SCORE">100</setvar></respcondition></resprocessing></item><item ident="g3sci-u06-q05" title="Question 5"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>true_false_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1.0</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>g3sci-u06-q05-a,g3sci-u06-q05-b</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>assessment_question_identifierref</fieldlabel><fieldentry>g3sci-u06-q05-bank</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;In rock layers that nothing has flipped or mixed, the deeper layers are older than the layers above them.&lt;/p&gt;</mattext></material><response_lid ident="response1" rcardinality="Single"><render_choice><response_label ident="g3sci-u06-q05-a"><material><mattext texttype="text/plain">True</mattext></material></response_label><response_label ident="g3sci-u06-q05-b"><material><mattext texttype="text/plain">False</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respident="response1">g3sci-u06-q05-a</varequal></conditionvar><setvar action="Set" varname="SCORE">100</setvar></respcondition></resprocessing></item><item ident="g3sci-u06-q06" title="Question 6"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>multiple_choice_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1.0</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>g3sci-u06-q06-a,g3sci-u06-q06-b,g3sci-u06-q06-c,g3sci-u06-q06-d</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>assessment_question_identifierref</fieldlabel><fieldentry>g3sci-u06-q06-bank</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;Which sentence is an observation, not an inference?&lt;/p&gt;</mattext></material><response_lid ident="response1" rcardinality="Single"><render_choice><response_label ident="g3sci-u06-q06-a"><material><mattext texttype="text/plain">The fossil footprint has three toes.</mattext></material></response_label><response_label ident="g3sci-u06-q06-b"><material><mattext texttype="text/plain">A dinosaur walked here long ago.</mattext></material></response_label><response_label ident="g3sci-u06-q06-c"><material><mattext texttype="text/plain">The animal that made it was a fast runner.</mattext></material></response_label><response_label ident="g3sci-u06-q06-d"><material><mattext texttype="text/plain">This place was once a swamp.</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respident="response1">g3sci-u06-q06-a</varequal></conditionvar><setvar action="Set" varname="SCORE">100</setvar></respcondition></resprocessing></item><item ident="g3sci-u06-q07" title="Question 7"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>multiple_choice_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1.0</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>g3sci-u06-q07-a,g3sci-u06-q07-b,g3sci-u06-q07-c,g3sci-u06-q07-d</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>assessment_question_identifierref</fieldlabel><fieldentry>g3sci-u06-q07-bank</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;Which is the strongest scientific inference about a tooth fossil?&lt;/p&gt;</mattext></material><response_lid ident="response1" rcardinality="Single"><render_choice><response_label ident="g3sci-u06-q07-a"><material><mattext texttype="text/plain">I think this animal ate plants.</mattext></material></response_label><response_label ident="g3sci-u06-q07-b"><material><mattext texttype="text/plain">This animal likely ate plants because its teeth are flat and wide.</mattext></material></response_label><response_label ident="g3sci-u06-q07-c"><material><mattext texttype="text/plain">This animal looked weird.</mattext></material></response_label><response_label ident="g3sci-u06-q07-d"><material><mattext texttype="text/plain">This is a really cool fossil.</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respident="response1">g3sci-u06-q07-b</varequal></conditionvar><setvar action="Set" varname="SCORE">100</setvar></respcondition></resprocessing></item><item ident="g3sci-u06-q08" title="Question 8"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>multiple_choice_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1.0</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>g3sci-u06-q08-a,g3sci-u06-q08-b,g3sci-u06-q08-c,g3sci-u06-q08-d</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>assessment_question_identifierref</fieldlabel><fieldentry>g3sci-u06-q08-bank</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;A scientist finds a fossil in dark, fine-grained mudstone. What does the kind of rock add to her investigation?&lt;/p&gt;</mattext></material><response_lid ident="response1" rcardinality="Single"><render_choice><response_label ident="g3sci-u06-q08-a"><material><mattext texttype="text/plain">Nothing. Only the fossil matters.</mattext></material></response_label><response_label ident="g3sci-u06-q08-b"><material><mattext texttype="text/plain">It tells her the exact age of the fossil.</mattext></material></response_label><response_label ident="g3sci-u06-q08-c"><material><mattext texttype="text/plain">It proves the animal lived in a desert.</mattext></material></response_label><response_label ident="g3sci-u06-q08-d"><material><mattext texttype="text/plain">It is more data. Dark mudstone forms in wet places like swamps.</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respident="response1">g3sci-u06-q08-d</varequal></conditionvar><setvar action="Set" varname="SCORE">100</setvar></respcondition></resprocessing></item><item ident="g3sci-u06-q09" title="Question 9"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>multiple_choice_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1.0</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>g3sci-u06-q09-a,g3sci-u06-q09-b,g3sci-u06-q09-c,g3sci-u06-q09-d</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>assessment_question_identifierref</fieldlabel><fieldentry>g3sci-u06-q09-bank</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;Dinosaur footprints are found in mudstone. What do the footprints tell us about that ground long ago?&lt;/p&gt;</mattext></material><response_lid ident="response1" rcardinality="Single"><render_choice><response_label ident="g3sci-u06-q09-a"><material><mattext texttype="text/plain">It was covered in ice.</mattext></material></response_label><response_label ident="g3sci-u06-q09-b"><material><mattext texttype="text/plain">It was the bottom of a deep ocean.</mattext></material></response_label><response_label ident="g3sci-u06-q09-c"><material><mattext texttype="text/plain">It was soft, wet mud.</mattext></material></response_label><response_label ident="g3sci-u06-q09-d"><material><mattext texttype="text/plain">It was hard, dry rock.</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respident="response1">g3sci-u06-q09-c</varequal></conditionvar><setvar action="Set" varname="SCORE">100</setvar></respcondition></resprocessing></item><item ident="g3sci-u06-q10" title="Question 10"><itemmetadata><qtimetadata><qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>multiple_answers_question</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>1.0</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>g3sci-u06-q10-a,g3sci-u06-q10-b,g3sci-u06-q10-c,g3sci-u06-q10-d</fieldentry></qtimetadatafield><qtimetadatafield><fieldlabel>assessment_question_identifierref</fieldlabel><fieldentry>g3sci-u06-q10-bank</fieldentry></qtimetadatafield></qtimetadata></itemmetadata><presentation><material><mattext texttype="text/html">&lt;p&gt;Which of these can become fossils? Choose ALL that are correct.&lt;/p&gt;</mattext></material><response_lid ident="response1" rcardinality="Multiple"><render_choice><response_label ident="g3sci-u06-q10-a"><material><mattext texttype="text/plain">Shells</mattext></material></response_label><response_label ident="g3sci-u06-q10-b"><material><mattext texttype="text/plain">Footprints</mattext></material></response_label><response_label ident="g3sci-u06-q10-c"><material><mattext texttype="text/plain">A pebble that was never alive</mattext></material></response_label><response_label ident="g3sci-u06-q10-d"><material><mattext texttype="text/plain">Bones</mattext></material></response_label></render_choice></response_lid></presentation><resprocessing><outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><and><varequal respident="response1">g3sci-u06-q10-a</varequal><varequal respident="response1">g3sci-u06-q10-b</varequal><not><varequal respident="response1">g3sci-u06-q10-c</varequal></not><varequal respident="response1">g3sci-u06-q10-d</varequal></and></conditionvar><setvar action="Set" varname="SCORE">100</setvar></respcondition></resprocessing></item></section></assessment></questestinterop>
