 "captions": [
  {
   "t": 4.4,
   "d": 5.6,
   "text": "This is Wyoming. Dry, dusty land, with hardly any water.",
   "voice": "opti-1"
  },
  {
   "t": 11.4,
   "d": 6.4,
   "text": "But hidden in this rock is something surprising...",
   "voice": "opti-2"
  },
  {
   "t": 18.5,
   "d": 2.9,
   "text": "A fish? Out here?",
   "voice": "opti-3"
  },
  {
   "t": 22.0,
   "d": 7.6,
   "text": "About 52 million years ago, this land was a warm lake. Fish swam everywhere.",
   "voice": "opti-4"
  },
  {
   "t": 30.4,
   "d": 4.8,
   "text": "Palm trees grew along its shore.",
   "voice": "opti-5"
  },
  {
   "t": 35.8,
   "d": 6.4,
   "text": "Layer by layer, mud buried them. Slowly, the mud turned to stone.",
   "voice": "opti-6"
  },
  {
   "t": 42.6,
   "d": 7.0,
   "text": "Today, scientists dig up these clues. Some even dive for them, right here in Florida.",
   "voice": "opti-7"
  },
  {
   "t": 50.6,
   "d": 5.2,
   "text": "Every fossil is a message from long ago. Let's learn to read it.",
   "voice": "opti-8"
  }
 ]
}